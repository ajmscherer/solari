{
  "manifest_version": 2,
  "name": "Tivoli Solari Switch",
  "version": "1.0.0",
  "description": "Solari button and Genius-error hide on the Volumio Now Playing kiosk",
  "content_scripts": [
    {
      "matches": [
        "http://localhost:4004/*",
        "http://127.0.0.1:4004/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
